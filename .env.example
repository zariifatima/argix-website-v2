# Optional. Copy to .env.local (never commit real secrets; these values are public in the built site).
# Form/email service endpoint that accepts JSON POST {name,email,company,need,message}:
VITE_FORM_ENDPOINT=
# Google Analytics measurement ID (G-XXXXXXXXXX). Loads only after the visitor accepts cookies:
VITE_GA_ID=
# Optional AI demo endpoint (your own server, never an API key):
VITE_AI_API_URL=
